<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Single, explicit feed. <clear /> removes any inherited machine-level source, so a
    private feed configured on a contributor machine cannot silently enter resolution
    (dependency confusion). Package source mapping pins every package to nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
