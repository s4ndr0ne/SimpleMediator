<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT smoke test. It compiles the console sample's sources unchanged and publishes them
    with PublishAot, so the whole SimpleMediator surface (assembly scanning, open generics closed
    over value types, pipeline behaviors, notifications, exception handlers) is exercised by the
    ILC compiler and executed as a native binary in CI.

    PublishAot must live here rather than on the command line: a global property would flow into
    the library's netstandard2.0 build, which does not support AOT (NETSDK1207).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Single-targeted (clearing the repo-wide TargetFrameworks) so `dotnet publish` needs no -f. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <!--
      The consumer-side IL2026/IL3050 at AddSimpleMediator/Send/Publish are expected until the source
      generator ships. Keep them out of the solution build; ILC still reports every warning at
      publish time, where the CI aot-smoke job inspects them.
    -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SimpleMediator.ConsoleSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SimpleMediator.Console\*.cs" LinkBase="ConsoleSample" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reflection-based assembly scanning cannot see types the trimmer removed, and handlers are
      only referenced through scanning. Rooting the application assembly keeps them.
      TODO: remove once the source generator emits explicit registrations.
    -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimpleMediator\SimpleMediator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
