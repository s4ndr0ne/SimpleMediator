<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT smoke test. It compiles the console sample's handlers unchanged, registers them with
    the source generator (AddSimpleMediatorGenerated) and publishes with PublishAot, so request,
    void, value-type, open-generic, pipeline, notification and exception-handler dispatch is compiled
    by ILC and executed as a self-checking native binary in CI.

    PublishAot must live here rather than on the command line: a global property would flow into
    the library's netstandard2.0 build, which does not support AOT (NETSDK1207).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Single-targeted (clearing the repo-wide TargetFrameworks) so `dotnet publish` needs no -f. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Any trim/AOT warning fails the build: the generated path must be warning-free. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SimpleMediator.AotSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SimpleMediator.Console\*.cs" Exclude="..\SimpleMediator.Console\Program.cs" LinkBase="ConsoleSample" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimpleMediator\SimpleMediator.csproj" />
    <!-- In-repo equivalent of a PackageReference to s4ndr0ne.SimpleMediator.SourceGenerator. -->
    <ProjectReference Include="..\..\src\SimpleMediator.SourceGenerator\SimpleMediator.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
